# Single process now serves all three tenants — one env file, not
# .env.uz/.env.tr/.env.eg. Values are read at runtime (see tenant.config.js),
# not baked into the build.

TENANT_UZ_HOSTNAMES=novaplastik.uz
TENANT_UZ_API_DOMAIN=https://api.novaplastik.uz
TENANT_UZ_WHATSAPP_PHONE=

TENANT_TR_HOSTNAMES=tr.novaplastik.com
TENANT_TR_API_DOMAIN=https://api.novaplastik.com
TENANT_TR_WHATSAPP_PHONE=

TENANT_EG_HOSTNAMES=eg.novaplastik.com
TENANT_EG_API_DOMAIN=https://api.novaplastik.com
TENANT_EG_WHATSAPP_PHONE=

# Default UI language for the whole app (en/ru/tr/ar) — see
# next-i18next.config.js for why this isn't per-tenant.
DEFAULT_LOCALE=ru
