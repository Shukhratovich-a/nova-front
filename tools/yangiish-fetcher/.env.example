# Copy to .env and fill in. NEVER commit .env — it holds a live session token.

# Base URL of the portal. Override only for testing against the local mock.
YANGIISH_BASE_URL=https://yangiish.mehnat.uz

# Seed token. Log in to the portal with E-IMZO, open DevTools -> Network,
# copy the value of the `authorization` header WITHOUT the "Bearer " prefix.
# Only needed for the first run, or after the refresh window has lapsed.
YANGIISH_TOKEN=

# Reporting year applied to every endpoint.
YANGIISH_YEAR=2026

# Records per request. The portal UI uses 20; higher values mean far fewer
# requests. Lower it if the API starts rejecting large pages.
YANGIISH_LIMIT=200

# How many endpoints are fetched at the same time. Pages within one endpoint
# are always sequential.
YANGIISH_CONCURRENCY=2

# Where the JSON files are written.
YANGIISH_OUT_DIR=./data

# Where the renewed session token is cached (mode 0600). Point separate copies
# of the tool at different files if you fetch for more than one account.
YANGIISH_TOKEN_FILE=./.token.json

# Sort order sent to the API. `id asc` is safer than `id desc` while the table
# is being written to, because new rows land on the last page instead of
# shifting every subsequent page.
YANGIISH_SORT=id asc

# Comma-separated candidate paths for the token refresh endpoint. The first one
# that works is remembered in .token.json. Confirm the real path in DevTools.
YANGIISH_REFRESH_PATHS=/api/api/v1/refresh,/api/api/v1/auth/refresh,/api/api/v1/esi-auth/refresh

# Per-request timeout (ms) and retry budget for 429/5xx/network errors.
YANGIISH_TIMEOUT_MS=60000
YANGIISH_RETRIES=4
